      "id": "check_weather_city",
      "displayName": "北京天气怎么样",
      "regex": "^(?!我想看|打开|播放|不要|别|关闭)(?:请)?(?:帮我)?(?:查询一下|查询|查一下|查查|查看|查|看看|搜索|搜一下)?((?:(?!今天|明天|后天|现在|当前).)*?)的?(今天|明天|后天|现在|当前)?的?天气(?:天气)*(?:怎么样|如何|情况)?$",
      "priority": 2,
      "hotwords": [
        "天 气",
        "天 气 预 报"
      ],
      "action": {
        "type": "builtin",
        "builtinAction": "check_weather",
        "builtinParams": {
          "city": "$param1",
          "period": "$param2"
        }
      }
    },
    {
      "id": "check_weather_date_first",
      "displayName": "明天上海天气",
